# Copy this file to `.env` and fill in your own values.
# `.env` is ignored by Git. Never commit a real API key.

# Anthropic API key. It stays on the local server and is never sent to the browser.
# Leave empty to use Paideia without AI features.
ANTHROPIC_API_KEY=

# Optional: the Claude model the tutor uses, and how much effort it spends
# thinking (low, medium, high, xhigh or max). Higher effort is slower and costs more.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# Address the local server listens on. Keep this on 127.0.0.1 (loopback only)
# unless you deliberately want other devices to reach it.
PAIDEIA_BIND=127.0.0.1:3000

# Where local learning data (database, imported files) will be stored.
PAIDEIA_DATA_DIR=./data

# Folder with the built web interface (output of `trunk build --release`).
PAIDEIA_WEB_DIST=./crates/paideia-web/dist

# Log level. Prompts, notes and document contents are never logged.
RUST_LOG=paideia_server=info,tower_http=warn
